# Groq API key. Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for all agents. Run `python -c "from groq import Groq; import os;
# [print(m.id) for m in Groq(api_key=os.environ['GROQ_API_KEY']).models.list().data]"`
# to see every model available to your key -- Groq's lineup changes over time,
# and free-tier accounts have separate per-model daily/per-minute quotas, so
# which model works best for you can vary. qwen/qwen3.8-27b is the default
# here after testing three options: openai/gpt-oss-120b is the most reliable
# at structured output but has a low free-tier daily token cap; openai/gpt-oss-20b
# sometimes mis-cases tool names in a way Groq rejects. If you hit 429
# rate-limit errors, ArchonAI retries with backoff automatically -- no action
# needed for brief pauses, but a persistent failure naming a daily/TPD limit
# means that specific model's quota is exhausted for the day; switch models.
GROQ_MODEL=qwen/qwen3.8-27b
