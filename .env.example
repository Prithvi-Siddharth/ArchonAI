# Groq API key. Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for all agents. Run `python -c "from groq import Groq; import os;
# [print(m.id) for m in Groq(api_key=os.environ['GROQ_API_KEY']).models.list().data]"`
# to see every model available to your key -- Groq's lineup changes over time,
# and free-tier accounts have separate per-model daily/per-minute quotas, so
# which model works best for you can vary. qwen/qwen3.8-27b is the default
# here after testing three options: openai/gpt-oss-120b is the most reliable
# at structured output but has a low free-tier daily token cap; openai/gpt-oss-20b
# sometimes mis-cases tool names in a way Groq rejects. If you hit 429
# rate-limit errors, ArchonAI retries with backoff automatically -- no action
# needed for brief pauses, but a persistent failure naming a daily/TPD limit
# means that specific model's quota is exhausted for the day; switch models.
GROQ_MODEL=qwen/qwen3.8-27b

# --- LLM provider ---
# Which provider the agents use: groq (default) or gemini.
# LLM_PROVIDER=groq

# --- Revision output ---
# delta (default): the Revision agent returns only its changes, merged in code --
# about 40% fewer revision output tokens; the same checks apply.
# full: it returns a complete architecture, as before -- set this to roll back.
# Unset or any other value means delta. Restart the worker after changing it.
# REVISION_OUTPUT_MODE=delta

# --- Designer research ---
# llm (default): the Architecture Designer searches the AWS knowledge base with
# LLM tool calls (2-3 extra LLM calls per job).
# digest: it gets a compact digest of the whole knowledge base instead -- no
# research LLM calls. Unset or any other value means llm. Restart the worker after changing it.
# DESIGNER_RESEARCH_MODE=llm

# Google Gemini (used when LLM_PROVIDER=gemini). Create a key at
# https://aistudio.google.com/apikey. The free tier is limited mainly by
# requests per day (check the limits page in AI Studio), not tokens per
# minute, so a design run is much faster than on Groq's free tier.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash
# How much the model "thinks" before answering: minimal, low (default),
# medium, high, or "default" for the model's own setting. Thinking tokens
# count toward each agent's output cap, so deep thinking can cut answers off.
# GEMINI_THINKING_LEVEL=low

# --- Background jobs (only needed for the /api/v1/architectures/jobs endpoints) ---
# All of these are optional: the defaults below match the local docker-compose
# setup, so uncomment a line only to override it.

# MySQL connection used to store job status and results.
# DATABASE_URL=mysql+pymysql://archon:archon@localhost:3306/archonai

# Redis connection used as the job queue.
# REDIS_URL=redis://localhost:6379/0

# Number of jobs a worker runs at the same time. Keep at 1 on a Groq free-tier
# key -- every design run already makes several LLM calls in parallel.
# WORKER_CONCURRENCY=1

# How many times a job is retried after a temporary failure (rate limit,
# timeout, network error), and how long to wait before retrying.
# JOB_MAX_RETRIES=1
# JOB_RETRY_DELAY_SECONDS=60

# A job running longer than this is stopped and marked failed.
# JOB_TIMEOUT_SECONDS=900

# --- AWS CloudWatch logs (optional) ---
# When enabled, API logs go to the /archonai/api log group and worker logs to
# /archonai/worker, in addition to the normal console output. If AWS is
# unreachable or misconfigured, the app keeps running and logs a warning.
# CLOUDWATCH_ENABLED=false

# AWS region of the log groups.
# AWS_REGION=ap-south-1

# Local development: the AWS CLI profile to use (credentials stay in ~/.aws,
# never in this file). Leave unset in production so the AWS SDK's default
# credential chain is used (environment variables or an attached IAM role).
# AWS_PROFILE=archonai-dev

# Override the log group names or how often batches are sent.
# CLOUDWATCH_API_LOG_GROUP=/archonai/api
# CLOUDWATCH_WORKER_LOG_GROUP=/archonai/worker
# CLOUDWATCH_SEND_INTERVAL_SECONDS=5

# --- AWS CloudWatch custom metrics (optional) ---
# When enabled, the worker publishes job, workflow and per-agent metrics to the
# ArchonAI namespace (uses AWS_REGION / AWS_PROFILE above). Separate from logs;
# needs only cloudwatch:PutMetricData (see monitoring/iam/). If AWS is
# unreachable, jobs keep running and a warning is logged.
# CLOUDWATCH_METRICS_ENABLED=false
# CLOUDWATCH_METRICS_NAMESPACE=ArchonAI
# CLOUDWATCH_METRICS_FLUSH_INTERVAL_SECONDS=10
