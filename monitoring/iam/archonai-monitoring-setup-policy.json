{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ViewMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "cloudwatch:ListDashboards",
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageArchonAIDashboard",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutDashboard",
        "cloudwatch:GetDashboard"
      ],
      "Resource": "arn:aws:cloudwatch::*:dashboard/ArchonAI"
    },
    {
      "Sid": "ManageArchonAIAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:SetAlarmState",
        "cloudwatch:DeleteAlarms"
      ],
      "Resource": "arn:aws:cloudwatch:ap-south-1:*:alarm:ArchonAI-*"
    }
  ]
}
